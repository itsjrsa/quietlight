{
  "name": "quietlight-journal",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild web/app.js --bundle --minify --splitting --format=esm --outdir=static/assets --entry-names=app",
    "test:ui": "node test-ui.mjs",
    "format": "prettier --write web static/*.html static/*.css static/*.js *.mjs package.json",
    "format:check": "prettier --check web static/*.html static/*.css static/*.js *.mjs package.json"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "15.0.12",
    "mermaid": "11.17.2"
  },
  "overrides": {
    "katex": "0.18.2"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "playwright": "1.56.1",
    "prettier": "3.6.2"
  }
}
